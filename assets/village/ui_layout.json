{
  "version": 1,
  "theme": {
    "ink": "#f6f0e6",
    "muted": "#c4b3a0",
    "orange": "#ff8a3d",
    "plum": "#120c16",
    "panel": "rgba(14, 10, 18, 0.62)"
  },
  "hud": {
    "anchor": "top-left",
    "inset": { "x": 14, "y": 12 },
    "rows": ["score", "coins", "where", "quest-tracker"],
    "align": "left",
    "gap": 2
  },
  "toolbar": {
    "anchor": "top-right",
    "inset": { "x": 14, "y": 12 },
    "direction": "row-reverse",
    "gap": 8,
    "buttons": ["pause", "map-btn", "quests-btn", "build-btn"],
    "labels": {}
  },
  "menus": {
    "main": {
      "sheet": "menu",
      "layout": { "justify": "center", "align": "center", "columns": 1, "gap": 12 },
      "copy": {
        "title": "CappyWorld",
        "kicker": "",
        "body": "Capybara Simulator",
        "event": {
          "title": "Halloween Live Event",
          "ends": "Ends Nov. 1st"
        }
      },
      "items": [
        { "type": "button", "ref": "story", "label": "Story mode" },
        { "type": "button", "ref": "multiplayer", "label": "Multiplayer" },
        { "type": "button", "ref": "world", "label": "World" },
        { "type": "note", "ref": "menu-version" }
      ]
    },
    "paused": {
      "sheet": "paused",
      "layout": { "justify": "center", "align": "center", "columns": 1, "gap": 12 },
      "copy": { "title": "Paused" },
      "items": [
        { "type": "button", "ref": "resume", "label": "Resume" },
        { "type": "button", "ref": "pause-clothes", "label": "Clothes" },
        { "type": "button", "ref": "pause-potions", "label": "Potions" },
        { "type": "separator" },
        { "type": "button", "ref": "pause-save", "label": "Save code" },
        { "type": "note", "ref": "pause-version" }
      ]
    }
  },
  "controls": {
    "actions": ["hop", "flop", "go"]
  }
}
